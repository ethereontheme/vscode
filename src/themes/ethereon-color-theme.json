    "tokenColors": [
        {
            "scope": "comment",
            "settings": {
                "foreground": "{{color_ee_base_55}}",
                "fontStyle": "italic"
            }
        },
        {
            "scope": ["variable", "support.variable"],
            "settings": {
                "foreground": "{{color_red_3}}"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "{{color_purple_0}}"
            }
        },
        {
            "scope": ["entity.name.class", "entity.name.type.class"],
            "settings": {
                "foreground": "{{color_yellow_3}}",
                "fontStyle": "bold"
            }
        },
        {
            "scope": "meta.class",
            "settings": {
                "foreground": "{{color_yellow_3}}",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "constant",
            "settings": {
                "foreground": "{{color_yellow_0}}"
            }
        },
        {
            "scope": ["entity.name.function", "support.function", "meta.function"],
            "settings": {
                "foreground": "{{color_blue_2}}",
                "fontStyle": "bold"
            }
        },
        {
            "scope": ["meta.function-call"],
            "settings": {
                "foreground": "{{color_blue_2}}"
            }
        },
        {
            "scope": "entity.name.method",
            "settings": {
                "foreground": "{{color_blue_1}}"
            }
        },
        {
            "scope": "string",
            "settings": {
                "foreground": "{{color_green_0}}"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": {
                "foreground": "{{color_teal_2}}"
            }
        },
        {
            "scope": "storage",
            "settings": {
                "foreground": "{{color_pink_2}}"
            }
        },
        {
            "scope": "",
            "settings": {
                "foreground": "{{color_pink_2}}"
            }
        }
    ]
}
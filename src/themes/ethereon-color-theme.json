        "editorGutter.foldingControlForeground": "{{color_ee_base_80}}",
        "editorCodeLens.foreground": "{{color_teal_1}}c0",

        "diffEditor.insertedTextBackground": "{{color_green_0}}40",
        "diffEditor.removedTextBackground": "{{color_red_4}}40",

        "editorMarkerNavigation.background": "{{color_ee_base_05}}",
        "editorMarkerNavigationError.background": "{{color_red_4}}",
        "editorMarkerNavigationWarning.background": "{{color_yellow_4}}",
        "editorMarkerNavigationInfo.background": "{{color_blue_4}}",

        "merge.currentHeaderBackground": "{{color_teal_3}}",
        "merge.currentContentBackground": "{{color_teal_4}}",
        "merge.incomingHeaderBackground": "{{color_blue_3}}",

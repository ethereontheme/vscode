{
  "name": "ethereontheme",
  "publisher": "rohit04saluja",
  "displayName": "Ethereon",
  "description": "Ethereon is a minimal and subtle theme designed to be pleasing on the eye",
  "version": "1.0.1",
  "license": "GPL-3.0-only",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ethereontheme/vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Ethereon Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/ethereon-dark-color-theme.json"
      },
      {
        "label": "Ethereon Light",
        "uiTheme": "vs",
        "path": "./themes/ethereon-light-color-theme.json"
      }
    ]
  },
  "devDependencies": {
    "json-templater": "^1.2.0"
  },
  "scripts": {
    "build": "node src/ethereon-color-theme.mjs"
  }
}

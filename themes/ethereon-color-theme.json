    "tokenColors": [
        {
            "scope": "comment",
            "settings": {
                "foreground": "#89898b",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "variable",
                "support.variable"
            ],
            "settings": {
                "foreground": "#B65E67"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#766E9B"
            }
        },
        {
            "scope": [
                "entity.name.class",
                "entity.name.type.class"
            ],
            "settings": {
                "foreground": "#BCAB62",
                "fontStyle": "bold"
            }
        },
        {
            "scope": "meta.class",
            "settings": {
                "foreground": "#BCAB62",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "constant",
            "settings": {
                "foreground": "#E1D696"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function"
            ],
            "settings": {
                "foreground": "#909CB1",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "meta.function-call"
            ],
            "settings": {
                "foreground": "#909CB1"
            }
        },
        {
            "scope": "entity.name.method",
            "settings": {
                "foreground": "#C4CAD6"
            }
        },
        {
            "scope": "string",
            "settings": {
                "foreground": "#88BC7D"
            }
        },
        {
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#86A8A4"
            }
        },
        {
            "scope": "storage",
            "settings": {
                "foreground": "#CAA1BC"
            }
        },
        {
            "scope": "",
            "settings": {
                "foreground": "#CAA1BC"
            }
        }
    ]
}